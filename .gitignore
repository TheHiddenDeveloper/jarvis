# Secrets — never commit
.env
*.env

# Runtime state (server.token, session id, mic capture)
state/

# Screenshots / debug logs
.screenshots/

# Python
venv/
__pycache__/
*.pyc

# Node
node_modules/
mcp/**/node_modules/

# Rust / Tauri build artifacts
widget/target/

# Piper models (re-downloaded on setup)
models/

# OS junk
.DS_Store

# Playwright MCP snapshots
.playwright-mcp/

# Vendored MCP server clone (manifests only tracked)
mcp/ai-vision-mcp/*
!mcp/ai-vision-mcp/package.json
!mcp/ai-vision-mcp/package-lock.json
